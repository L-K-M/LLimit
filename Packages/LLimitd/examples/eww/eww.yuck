;; eww widget for LLimit — copy into ~/.config/eww/ (merge the defpoll/defwidget
;; into your own eww.yuck, the styles into your eww.scss) and open with:
;;
;;   eww open llimit
;;
;; eww parses the poll output as JSON automatically, so `llimit.text`,
;; `llimit.class`, `llimit.tooltip` and the `llimit.accounts` array are directly
;; usable as fields.

(defpoll llimit :interval "300s"
  :initial '{"text":"LLimit","class":"empty","tooltip":"No quota snapshot yet"}'
  "llimit status --json")

(defwidget llimit []
  (box :class "llimit ${llimit.class}"
       :tooltip {llimit.tooltip}
       :space-evenly false
    (label :text {llimit.text})))

;; Standalone demo window. In a real setup you'd drop the (llimit) widget into
;; your existing bar instead — the widget itself carries no background, your bar
;; provides it. The .llimit-demo wrapper gives this demo window a dark surface so
;; the class colors stay readable.
(defwindow llimit
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "24px"
                      :anchor "top center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (box :class "llimit-demo"
    (llimit)))
